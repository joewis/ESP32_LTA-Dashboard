; ─────────────────────────────────────────────────────────────────────────────
;  Copy this file to `secret.ini` and fill in your own values.
;
;      cp secret.ini.example secret.ini
;
;  `secret.ini` is git-ignored. Never commit it, and never paste real values
;  into this example file.
;
;  PlatformIO picks it up through `extra_configs = secret.ini` in platformio.ini.
; ─────────────────────────────────────────────────────────────────────────────

[secrets]
build_flags =
    -D WIFI_SSID=\"your_wifi_ssid\"
    -D WIFI_PASSWORD=\"your_wifi_password\"
    -D LTA_API_KEY=\"your_lta_datamall_account_key\"
    -D DATAGOVSG_API_KEY=\"your_data_gov_sg_api_key\"
